# ── Server ──────────────────────────────────────────────
# Port the API listens on (Vite dev server proxies /api to it)
PORT=3180
# development | production | test
NODE_ENV=development
# Path to the SQLite database file (Phase 1)
DATABASE_URL=./data/alivocab.db

# ── Secrets (required from Phase 1; app refuses to boot without them) ──
# 32 random bytes, base64:  openssl rand -base64 32
APP_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
# Public URL of the app (used by auth for cookies/redirects)
BETTER_AUTH_URL=http://localhost:5180

# ── Bootstrap ───────────────────────────────────────────
# First admin account created by `pnpm db:seed` (password min 8 chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Security ────────────────────────────────────────────
# Allow AI base URLs on private/loopback networks (e.g. a local Ollama/LM Studio).
# Defaults to true in development and false in production (SSRF protection).
# ALLOW_PRIVATE_AI_BASE_URLS=false

# ── Pictures ────────────────────────────────────────────
# Where resized pictures are stored (relative to the repo root, or absolute)
MEDIA_DIR=./data/media
# Optional free Pexels key (https://www.pexels.com/api/) for better everyday-object photos.
# Without it, Wikimedia Commons (fast) and Openverse (slow; 200 searches/day) are used, no key needed.
# PEXELS_API_KEY=
# Optional contact (your site URL or an email) sent in the User-Agent. Wikimedia asks API clients
# to identify themselves and limits anonymous ones more strictly.
# PICTURES_CONTACT=https://vocab.example.org
