{
  "name": "@alivocab/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@alivocab/ai": "workspace:*",
    "@alivocab/core": "workspace:*",
    "@alivocab/db": "workspace:*",
    "@alivocab/shared": "workspace:*",
    "@hono/node-server": "^2.1.4",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "nanoid": "^6.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "ai": "^7.0.133",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
