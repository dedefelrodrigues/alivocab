{
  "name": "@alivocab/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:palettes": "pnpm --filter @alivocab/shared gen:palettes-css ../../apps/web/src/styles/palettes.generated.css",
    "dev": "pnpm gen:palettes && vite",
    "build": "pnpm gen:palettes && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@alivocab/shared": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "hono": "^4.13.13",
    "lucide-react": "^1.53.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@alivocab/api": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
